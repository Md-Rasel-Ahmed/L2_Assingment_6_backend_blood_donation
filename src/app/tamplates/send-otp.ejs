<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Verify Your Email - Donation Healthcare</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7f9;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <div
      style="
        max-width: 600px;
        margin: 40px auto;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
      "
    >
      <!-- Header -->
      <div
        style="
          background-color: #0f766e;
          padding: 28px 20px;
          text-align: center;
        "
      >
        <h1 style="margin: 0; color: #ffffff; font-size: 28px">
          Donation Healthcare
        </h1>

        <p style="margin: 8px 0 0; color: #d1fae5; font-size: 14px">
          Connecting donors with those in need
        </p>
      </div>

      <!-- Content -->
      <div style="padding: 40px 35px">
        <h2 style="margin: 0 0 20px; color: #1f2937; font-size: 24px">
          Verify Your Email
        </h2>

        <p
          style="
            margin: 0 0 15px;
            color: #4b5563;
            font-size: 16px;
            line-height: 1.6;
          "
        >
          Hello <strong><%= name %></strong>,
        </p>

        <p
          style="
            margin: 0 0 25px;
            color: #4b5563;
            font-size: 16px;
            line-height: 1.6;
          "
        >
          Thank you for registering with
          <strong>Donation Healthcare</strong>. Please use the verification code
          below to verify your email address.
        </p>

        <!-- OTP -->
        <div style="text-align: center; margin: 30px 0">
          <div
            style="
              display: inline-block;
              background-color: #f0fdfa;
              border: 2px dashed #0f766e;
              border-radius: 10px;
              padding: 18px 35px;
            "
          >
            <span
              style="
                color: #0f766e;
                font-size: 34px;
                font-weight: bold;
                letter-spacing: 8px;
              "
            >
              <%= otp %>
            </span>
          </div>
        </div>

        <p
          style="margin: 0; text-align: center; color: #6b7280; font-size: 14px"
        >
          This verification code will expire in
          <strong>5 minutes</strong>.
        </p>

        <!-- Security Notice -->
        <div
          style="
            margin-top: 30px;
            padding: 15px;
            background-color: #fef3c7;
            border-radius: 8px;
          "
        >
          <p
            style="margin: 0; color: #92400e; font-size: 13px; line-height: 1.5"
          >
            <strong>Security Notice:</strong>
            Never share this verification code with anyone. Donation Healthcare
            will never ask you for your OTP.
          </p>
        </div>

        <p
          style="
            margin-top: 30px;
            color: #6b7280;
            font-size: 14px;
            line-height: 1.6;
          "
        >
          If you did not create an account with Donation Healthcare, you can
          safely ignore this email.
        </p>
      </div>

      <!-- Footer -->
      <div
        style="
          background-color: #f9fafb;
          padding: 20px;
          text-align: center;
          border-top: 1px solid #e5e7eb;
        "
      >
        <p style="margin: 0; color: #9ca3af; font-size: 12px">
          © <%= year %> Donation Healthcare. All rights reserved.
        </p>

        <p style="margin: 8px 0 0; color: #9ca3af; font-size: 12px">
          Making healthcare connections easier.
        </p>
      </div>
    </div>
  </body>
</html>
